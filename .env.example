# ───────────────────────────────────────────────────────────────────────────
#  🥰 MONA LISA 🤭 — environment template
#  Copy to .env and fill in the values you need. Everything below is optional
#  except OWNER_NUMBER and (on hosts with no persistent disk) MONGODB_URI.
# ───────────────────────────────────────────────────────────────────────────

# ── Identity / access ──
OWNER_NUMBER=237682432296
OWNER_NAME=PROGRESS TECH
BOT_NAME=🥰 MONA LISA V2 🤭
PREFIX=.

# Session restore (leave blank to pair fresh via the web page)
SESSION_ID=
# MongoDB Atlas connection string (needed on hosts that wipe the disk)
MONGODB_URI=

# ── Behaviour ──
MODE=public
DEBUG=false
# Pairing command from inside a chat — owner-only by default for safety
ALLOW_PUBLIC_PAIR_COMMAND=false

# ── Channel ──
# The bot attaches this channel to result menus and AI outputs.
CHANNEL_JID=120363431455356251@newsletter
CHANNEL_LINK=https://whatsapp.com/channel/0029Vb8rLzOCRs1j79bllH05
AUTO_FOLLOW_CHANNEL=true
AUTO_CHANNEL_REACT=true

# ── OmegaTech AI (no API key required) ──
# All AI / image / music commands use this service.
OMEGATECH_API=https://api.omegatech.app
OMEGATECH_TIMEOUT=120000
# Default model for .ai / .translate / .summarize / .code
OMEGA_CHAT_MODEL=deepseek-v3.2

# ── Keep-alive (optional; useful on Render free, which sleeps when idle) ──
# KEEP_ALIVE=true
# KEEP_ALIVE_URL=https://your-service.onrender.com

# ── Optional Telegram notifications ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
